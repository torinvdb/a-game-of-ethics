  "name": "a-game-of-ethics",
  "version": "2.0.2",
  "frozen_at": "2026-11-06",
  "status": "pre-registration draft: hashes frozen, inter-rater review of axis deltas pending (PROTOCOL.md section 6)",
  "protocol": {
    "path": "benchmark/PROTOCOL.md",
