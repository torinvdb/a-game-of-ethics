{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/torinvdb/a-game-of-ethics/schemas/agent-ack.schema.json",
  "title": "agoe.agent/v1 start/end reply",
  "description": "Agent to harness in reply to start and end.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "ok"
      ],
      "properties": {
        "ok": {
          "const": true
        }
      }
    },
    {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,39}$"
        }
      }
    }
  ]
}
