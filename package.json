{
  "name": "a-game-of-ethics",
  "version": "1.0.0",
  "description": "Scenario-Based Alignment Benchmark for Large Language Models",
  "main": "ethi-cli.js",
  "type": "module",
  "scripts": {
    "start": "node ethi-cli.js",
    "manual": "node ethi-cli.js manual",
    "model": "node ethi-cli.js model",
    "analyze": "node src/analyze.js",
    "analyze:auto": "node src/analyze.js --auto",
    "debug-scenarios": "node src/debug.js",
    "ethics:test": "cd extensions/time-travel-ethics && python3 -m unittest discover -s tests -v",
    "ethics:demo": "python3 extensions/time-travel-ethics/tools/demo.py",
    "test": "node --test \"test/**/*.test.js\"",
    "ethics:scaffold": "python3 extensions/time-travel-ethics/tools/scaffold-eval.py --split all --output",
    "ethics:verify-evidence": "python3 extensions/time-travel-ethics/tools/verify-evidence.py",
    "ethics:replay": "python3 talks/three-years-in-thirty-minutes/demo/replay.py",
    "benchmark:check": "node benchmark/check_scenarios.mjs && python3 benchmark/manifest.py verify",
    "benchmark:test": "python3 -m unittest discover -s benchmark/run -p 'test_*.py' -v",
    "bench:run": "node benchmark/run/run.mjs",
    "bench:cluster": "python3 benchmark/run/cluster.py",
    "bench:analyze": "python3 benchmark/run/analyze.py",
    "bench:agent": "node benchmark/run/run.mjs",
    "bench:cluster-agent": "node benchmark/run/cluster-agent.mjs",
    "schemas:validate": "node schemas/validate.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "chalk": "^6.0.1",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "figlet": "^1.12.0",
    "inkjs": "^2.4.0",
    "inquirer": "^14.2.5",
    "nanospinner": "^1.2.2"
  },
  "bin": {
    "ethi": "./ethi-cli.js"
  },
  "keywords": [
    "ethics",
    "llm",
    "alignment",
    "narrative",
    "scenarios",
    "ink",
    "benchmark"
  ],
  "author": "torinvdb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/torinvdb/a-game-of-ethics.git"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
